Algoritmo switch_cas
	Definir op Como Entero
	Repetir
		Escribir"SOFWARE 1"
		Escribir"SOFWARE 2"
		Escribir"SOFWARE 3"
		Leer op
		Segun op Hacer
			1:
				Limpiar pantalla
				Escribir "Digito de sofware 1 "
			2:
				Limpiar pantalla 
				Escribir "Digito sofware 2"
			3:
				Limpiar Pantalla 
				Escribir "Digito de sofware 3"
			De Otro Modo:
				Escribir "Digito un numero equivocado"
		Fin segun
		Escribir "Digito si 1 o no 0 "
		Leer res
		Escribir "Gracias por usaer el programa"
	Hasta Que res=0
FinAlgoritmo
