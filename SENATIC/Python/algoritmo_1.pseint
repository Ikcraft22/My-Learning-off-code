Proceso CalcularPromedioPares
	// Requerimiento 1: Cálculo del promedio de números pares en una lista
	// Temas aplicados: Cálculos matemáticos, gestión de colecciones, funciones

	Dimension numeros[10]
	Dimension numeros_pares[10]
	Definir suma, cantidad, promedio Como Real
	Definir i, j Como Entero

	// Lista de ejemplo
	numeros[1] <- 1
	numeros[2] <- 2
	numeros[3] <- 3
	numeros[4] <- 4
	numeros[5] <- 5
	numeros[6] <- 6
	numeros[7] <- 7
	numeros[8] <- 8
	numeros[9] <- 9
	numeros[10] <- 10

	// Filtrar los números pares
	j <- 1
	Para i <- 1 Hasta 10 Con Paso 1 Hacer
		Si numeros[i] MOD 2 = 0 Entonces
			numeros_pares[j] <- numeros[i]
			j <- j + 1
		Fin Si
	Fin Para

	// Verificar si hay números pares
	Si j = 1 Entonces
		Escribir "El promedio de los números pares es: 0"
		Fin Proceso
	Fin Si

	// Calcular el promedio
	suma <- 0
	Para i <- 1 Hasta j - 1 Con Paso 1 Hacer
		suma <- suma + numeros_pares[i]
	Fin Para
	cantidad <- j - 1
	promedio <- suma / cantidad

	// Mostrar el resultado
	Escribir "El promedio de los números pares es: ", promedio
Fin Proceso