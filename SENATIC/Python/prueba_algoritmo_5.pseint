Proceso PruebaTorresDeHanoi
	// Prueba de escritorio para resolver las Torres de Hanoi con 3 discos
	// Torres: Origen, Destino, Auxiliar

	SubProceso ResolverHanoi(n, origen, destino, auxiliar)
		Si n = 1 Entonces
			Escribir "Mover disco 1 de ", origen, " a ", destino
			Fin SubProceso
		Fin Si

		// Paso 1: Mover n-1 discos de origen a auxiliar
		Llamar ResolverHanoi(n - 1, origen, auxiliar, destino)

		// Paso 2: Mover el disco más grande de origen a destino
		Escribir "Mover disco ", n, " de ", origen, " a ", destino

		// Paso 3: Mover n-1 discos de auxiliar a destino
		Llamar ResolverHanoi(n - 1, auxiliar, destino, origen)
	Fin SubProceso

	Definir num_discos Como Entero

	// Paso 4: Definir el número de discos
	num_discos <- 3

	// Paso 5: Resolver el problema
	Escribir "Resolviendo Torres de Hanoi para ", num_discos, " discos:"
	Llamar ResolverHanoi(num_discos, "Origen", "Destino", "Auxiliar")
Fin Proceso